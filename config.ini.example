# ---------------------------------------------------------------------------
# Wan 3.0 video node configuration
#
# Copy this file to "config.ini" in the same folder, fill in KEY, then restart
# ComfyUI. "config.ini" is ignored by Git, so your key stays out of the repo.
#
# Environment variables win over this file:
#   DASHSCOPE_BASE_URL / VERGORA_BASE_URL
#   DASHSCOPE_API_KEY / VERGORA_API_KEY
#   DASHSCOPE_WORKSPACE_ID, DASHSCOPE_REGION
# ---------------------------------------------------------------------------

[API]

# Vergora is selected when BASE_URL is set:
#   submit POST https://api.vergora.ai/v1/videos
#   poll   GET  https://api.vergora.ai/v1/videos/{task_id}
BASE_URL = https://api.vergora.ai/v1

# Required for either target.
KEY =

# Optional: used only when BASE_URL is empty. The node then calls the official
# Alibaba Cloud Model Studio endpoint:
# https://{WORKSPACE_ID}.{REGION}.maas.aliyuncs.com
WORKSPACE_ID =
REGION = ap-southeast-1

[RUNTIME]

# Seconds between two task status polls.
POLL_INTERVAL = 10

# Maximum seconds to wait for one job before the node gives up.
# Video generation normally takes 1 to 5 minutes.
TIMEOUT = 1200

# Folder where finished .mp4 files are saved.
# Leave empty to use ComfyUI's own output directory.
OUTPUT_DIR =

# ---------------------------------------------------------------------------
# 中文说明
#
# 1. 把这个文件复制为 config.ini
# 2. 使用 Vergora：保留上面的 BASE_URL，并填写 KEY
# 3. 使用阿里云百炼原厂：把 BASE_URL 留空，填写 WORKSPACE_ID、REGION 和 KEY
# 4. 重启 ComfyUI
#
# 两种地址都使用官方 Wan 3.0 的 model + input + parameters 请求结构。
# Vergora 走 /v1/videos，原厂走 /api/v1/services/aigc/... 和 /api/v1/tasks/...
# 环境变量优先级高于本文件。config.ini 已被 .gitignore 忽略。
# ---------------------------------------------------------------------------
