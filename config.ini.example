# ---------------------------------------------------------------------------
# Wan 3.0 video node - Alibaba Cloud Model Studio configuration
#
# How to use:
#   1. copy this file to "config.ini" in the same folder
#        Windows:        copy config.ini.example config.ini
#        macOS / Linux:  cp config.ini.example config.ini
#   2. fill in WORKSPACE_ID and KEY
#   3. restart ComfyUI
#
# "config.ini" is listed in .gitignore, so your key never reaches the repo.
# Environment variables win over this file:
#   DASHSCOPE_WORKSPACE_ID, DASHSCOPE_REGION,
#   DASHSCOPE_API_KEY, DASHSCOPE_BASE_URL
# ---------------------------------------------------------------------------

[API]

# Model Studio business workspace ID. The endpoint is:
# https://{WORKSPACE_ID}.{REGION}.maas.aliyuncs.com
WORKSPACE_ID =

# Region used in the endpoint, for example:
#   ap-southeast-1 (Singapore), cn-beijing, ap-northeast-1,
#   eu-central-1, us-east-1, cn-hongkong
REGION = ap-southeast-1

# DashScope / Model Studio API key. Required.
KEY =

# Optional full origin override. Leave empty to build it from WORKSPACE_ID and REGION.
# BASE_URL =

[RUNTIME]

# Seconds between two task status polls. The official guide recommends about 15.
POLL_INTERVAL = 15

# Maximum seconds to wait for one job before the node gives up.
# Video generation normally takes 1 to 5 minutes.
TIMEOUT = 1200

# Folder where finished .mp4 files are saved.
# Leave empty to use ComfyUI's own output directory (recommended).
OUTPUT_DIR =

# ---------------------------------------------------------------------------
# 中文说明
#
# 1. 把这个文件复制为 config.ini（Windows：copy config.ini.example config.ini）
# 2. 在 WORKSPACE_ID 填业务空间 ID，在 KEY 填 Model Studio / DashScope API Key
# 3. REGION 必须和业务空间、API Key 所属地域一致
# 4. 重启 ComfyUI
#
# 默认接口地址根据 WORKSPACE_ID 和 REGION 自动生成，一般不需要填写 BASE_URL。
# POLL_INTERVAL 是轮询间隔（秒），TIMEOUT 是单个任务最长等待（秒），OUTPUT_DIR 留空
# 表示保存到 ComfyUI 自己的输出目录。也可以用环境变量 DASHSCOPE_API_KEY、
# DASHSCOPE_WORKSPACE_ID、DASHSCOPE_REGION、DASHSCOPE_BASE_URL 代替本文件，
# 环境变量的优先级更高。config.ini 已被 .gitignore 忽略。
# ---------------------------------------------------------------------------
